    "Claim Granted Within Cap?": {"main": [[{"node": "Fetch One X Page", "type": "main", "index": 0}], []]},
    "Fetch One X Page": {"main": [[{"node": "Normalize One Page", "type": "main", "index": 0}]]},
    "Normalize One Page": {"main": [[{"node": "Persist Page And Checkpoint", "type": "main", "index": 0}]]}
  },
